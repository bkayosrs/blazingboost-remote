{
  "name": "boost-remote-host",
  "version": "1.0.0",
  "description": "This program helps you let boosters play your preferred games on your PC.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "koffi": "2.9.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.boostremote.host",
    "productName": "Blazingboost Remote",
    "files": [
      "main.js",
      "preload.js",
      "win32.js",
      "input.js",
      "renderer/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Blazingboost Remote.exe"
    }
  },
  "author": "Blazingboost"
}
